{
    "manifest_version": 3,
    "name": "Youtube Shorts Runner - 67 Edition",
    "version": "1.0",
    "permissions": [
        "scripting",
        "activeTab",
        "tabs"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "index.html",
                "assets/*"
            ],
            "matches": [
                "https://www.youtube.com/*"
            ]
        }
    ]
}